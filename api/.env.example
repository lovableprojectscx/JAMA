DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jama
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/jama_test
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_DURACION=12h
PORT=3000

# Etapa 4: subida de fotos (Supabase Storage). El bucket debe ser público.
# SUPABASE_URL es la URL del proyecto (https://xxxx.supabase.co), no la de la base de datos.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role (nunca la anon/public).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fotos-ofertas
