DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jama
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/jama_test
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_DURACION=12h
PORT=3000

# Etapa 4: subida de fotos (Supabase Storage). El bucket debe ser público.
# SUPABASE_URL es la URL del proyecto (https://xxxx.supabase.co), no la de la base de datos.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role (nunca la anon/public).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fotos-ofertas

# Despliegue en Vercel + Supabase (ver vercel.json y REPORTE.md):
# - DATABASE_URL en Vercel debe ser el POOLER de transacciones de Supabase
#   (puerto 6543, usuario postgres.<project-ref>), no la conexión directa —
#   cada invocación serverless puede ser un proceso nuevo y la directa se
#   queda sin conexiones disponibles rápido. `npm run migrate` local sí usa
#   la conexión directa (puerto 5432), porque el pooler no soporta DDL bien.
# - CRON_SECRET: en Vercel lo genera la plataforma sola al agregar el cron
#   (no hace falta definirlo a mano ahí); localmente ponle cualquier valor
#   si quieres probar GET /api/v1/cron/expirar-reservas a mano.
CRON_SECRET=
